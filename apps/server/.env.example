# SentinelAI backend — local development environment template.
# Copy to `.env` (gitignored) and fill in. NEVER commit real secrets.
# In every real environment these values come from Vault via the External
# Secrets Operator, never from a committed file (docs/deployment-architecture.md).

# --- application ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# --- database (async driver only — asyncpg, never a sync driver) ---
DATABASE_URL=postgresql+asyncpg://sentinelai:sentinelai@localhost:5432/sentinelai
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# --- redis (arq queue + caching) ---
REDIS_URL=redis://localhost:6379/0

# --- auth / tokens (placeholders only — replace via Vault in real envs) ---
JWT_SECRET_KEY=dev-only-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1209600

# --- object storage (evidence blobs) ---
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_BUCKET=sentinelai-evidence
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin

# --- key management (KMS) — ADR-0009 (provider-agnostic) ---
# dev | vault_transit | aws_kms | azure_key_vault | gcp_kms | pkcs11
KMS_PROVIDER=dev
KMS_DEV_KEYSTORE=.kms-dev-keystore
KMS_SIGNING_ALGORITHM=ED25519
KMS_HYBRID_SIGNING=false
# Vault Transit provider (used only when KMS_PROVIDER=vault_transit)
VAULT_ADDR=http://localhost:8200
VAULT_TRANSIT_MOUNT=transit
VAULT_TOKEN=dev-only-change-me
VAULT_AUTH_METHOD=token            # token | approle
# VAULT_ROLE_ID=...                # required for approle
# VAULT_SECRET_ID=...              # required for approle
# KMS resilience (ADR-0009 H2)
KMS_RETRY_MAX_ATTEMPTS=4
KMS_RETRY_BASE_DELAY=0.1
KMS_RETRY_MAX_DELAY=5.0
KMS_TIMEOUT_SECONDS=10.0
KMS_BREAKER_FAILURE_THRESHOLD=5
KMS_BREAKER_RESET_SECONDS=30.0
