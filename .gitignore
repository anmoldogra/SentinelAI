# --- OS / Editor ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/*
!.vscode/extensions.json

# --- Environment / secrets ---
.env
.env.*
!.env.example

# KMS dev provider keystore — local software private keys, NEVER commit (ADR-0009)
.kms-dev-keystore/
**/.kms-dev-keystore/
*.kms-keystore
*.pem
*.key
!**/keys/*.example

# --- Node / JS / TS ---
node_modules/
dist/
build/
.turbo/
.next/
out/
*.tsbuildinfo
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Docker ---
*.pid

# --- Terraform ---
